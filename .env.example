# Copy this file to .env and edit the values
PORT=3000

# Anyone who signs up with one of these emails becomes an owner automatically
# (comma-separated). If the account already exists it is upgraded on next start.
OWNER_EMAILS=wisdomudoudo24@gmail.com

# Long random string used to sign login tokens (required on Vercel; generated locally if blank)
JWT_SECRET=

# Hosted database (required on Vercel). Leave blank to use a local file at data/school.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
